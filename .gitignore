# ---- 系统与编辑器 ----
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.tmp

# ---- 通用过程残留 ----
*.log
logs/
dump.rdb

# Python 依赖与缓存（仓库中实际存在，非教学源码）
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# ---- 本地配置与密钥（绝不入库）----
.env
.env.local
.env.*.local
*.pem
*.key

# ---- 教学实操环境：RabbitMQ 运行时数据（rabbitmq 课程）----
# 风险点：阶段 4 起做集群/镜像实操时，若在仓库目录内启动节点，
# Mnesia/Khepri 数据库与日志会就地生成（体积大、可再生），需忽略。
rabbitmq_server-[0-9]*/
**/playground/**/mnesia/
**/playground/**/khepri/

# ---- 下载的工具二进制（非教学内容，可重新下载）----
*.exe
*.zip

# ---- 教学压缩包例外（必须放在 *.zip 之后：Git 后置规则优先）----
# *.zip 用于忽略下载的中间件发行版，但教学自制的数据包/素材包要保留。
!rabbitmq/**/*.zip
!*-教学素材.zip

# ---- 教学实操环境：ES 发行包与集群数据目录 ----
# 说明：这些是解压/运行产生的二进制运行时（约 4 GB），不是教学内容。
# 教学产物是下面的 stages/ 与各主题根目录下的 *.md / assets/*.svg，
# 以及 playground/ 顶层被讲义引用的 *.json / *.ndjson / *.ps1 载荷。
elasticsearch/playground/l9-cluster/
elasticsearch/playground/elasticsearch-9.5.1/
elasticsearch/playground/snapshots/
elasticsearch/playground/backup-*/
elasticsearch-9.5.1-*.zip

# ---- 教学实操环境：Redis 运行时数据（redis 课程）----
# 风险点：redis.conf 的 dir 默认值是 ./（即启动 redis-server 时的当前目录）。
# 若在仓库目录内直接启动而未指定 --dir，RDB 快照与 AOF 会就地生成，
# 与上面的 dump.rdb 属于同一类过程残留，只是覆盖了自定义文件名与 Redis 7+ 多段 AOF。
*.rdb
appendonlydir/
*.aof
# Redis Cluster 自动生成的节点状态文件（阶段 4 分布式实践会产生）
nodes-[0-9]*.conf

# ---- 教学实操环境：Node 依赖目录（typescript-core 课程）----
# 说明：课 1 的 npm i -D typescript 会就地生成 node_modules/（数百至数千个文件），
# 它不是教学内容，可由 package.json 随时重新安装。
# 教学产物是 playground 下的 .ts 源码与各主题目录下的 *.md / assets/*.svg。
node_modules/

# ---- 教学实操环境：TS 编译产物（typescript-core 课程）----
# 说明：tsc 默认与源文件同目录产出 .js，属编译产物而非教学内容，
# 可由 npx tsc 一条命令重新生成。
# ⚠️ 陷阱：不能裸写 *.js —— playground/scenario.js 是课 1 讲义引用的手写 JS 源文件。
# 后续若再新增手写 .js 示例，同样要在此加一条 ! 例外，否则会被连带吞掉。
/frontend/typescript-core/playground/*.js
!/frontend/typescript-core/playground/scenario.js

# ---- 教学实操环境：Consul 运行时数据（consul 课程）----
# 风险点：lesson-05 的集群配置里 data_dir 直指仓库内的 playground/cluster/data/，
# 节点一启动就地生成 raft.db、serf 快照、node-id、services 元数据（可再生，约 1 MB）。
# 教学产物是同目录下的 *.json 配置（node1.json / dc2.json 等），继续跟踪，不受影响。
consul/playground/cluster/data/

# consul-template 渲染产物：*.tpl / *.hcl 是教学载荷，渲染出来的 .out 不是
consul/playground/*.out

# ---- 下载的工具存放目录（consul 课程）----
# lesson-06 让学员把 consul / consul-template 二进制下载到这里；
# 二进制本体已被上面的 *.exe 忽略，剩下的第三方 LICENSE.txt 也不是教学内容。
consul/playground/tools/

# ---- 前端课程：Node 依赖目录（frontend/ 下 JS / TS 课程）----
# 风险点：模块化、实战项目等章节一旦执行 npm install，node_modules/ 会就地生成
# （数万文件、体积大、可再生）。npm-debug.log* 已被上面的 *.log 覆盖。
# 教学产物是各主题下的 *.md / assets/*.svg / 实现/ 里的源码，继续跟踪，不受影响。
node_modules/
.workbuddy/