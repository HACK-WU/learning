# ---- 系统与编辑器 ----
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.tmp

# ---- 通用过程残留 ----
*.log
logs/
dump.rdb

# Python 依赖与缓存（仓库中实际存在，非教学源码）
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# ---- 本地配置与密钥（绝不入库）----
.env
.env.local
.env.*.local
*.pem
*.key

# ---- 教学实操环境：RabbitMQ 运行时数据（rabbitmq 课程）----
# 风险点：阶段 4 起做集群/镜像实操时，若在仓库目录内启动节点，
# Mnesia/Khepri 数据库与日志会就地生成（体积大、可再生），需忽略。
rabbitmq_server-[0-9]*/
**/playground/**/mnesia/
**/playground/**/khepri/

# ---- 下载的工具二进制（非教学内容，可重新下载）----
*.exe
*.zip

# ---- 教学压缩包例外（必须放在 *.zip 之后：Git 后置规则优先）----
# *.zip 用于忽略下载的中间件发行版，但教学自制的数据包/素材包要保留。
!rabbitmq/**/*.zip
!*-教学素材.zip

# ---- 教学实操环境：ES 发行包与集群数据目录 ----
# 说明：这些是解压/运行产生的二进制运行时（约 4 GB），不是教学内容。
# 教学产物是下面的 stages/ 与各主题根目录下的 *.md / assets/*.svg，
# 以及 playground/ 顶层被讲义引用的 *.json / *.ndjson / *.ps1 载荷。
elasticsearch/playground/l9-cluster/
elasticsearch/playground/elasticsearch-9.5.1/
elasticsearch/playground/snapshots/
elasticsearch/playground/backup-*/
elasticsearch-9.5.1-*.zip

# ---- 教学实操环境：Redis 运行时数据（redis 课程）----
# 风险点：redis.conf 的 dir 默认值是 ./（即启动 redis-server 时的当前目录）。
# 若在仓库目录内直接启动而未指定 --dir，RDB 快照与 AOF 会就地生成，
# 与上面的 dump.rdb 属于同一类过程残留，只是覆盖了自定义文件名与 Redis 7+ 多段 AOF。
*.rdb
appendonlydir/
*.aof
# Redis Cluster 自动生成的节点状态文件（阶段 4 分布式实践会产生）
nodes-[0-9]*.conf

# ---- 教学实操环境：Node 依赖目录（typescript-core 课程）----
# 说明：课 1 的 npm i -D typescript 会就地生成 node_modules/（数百至数千个文件），
# 它不是教学内容，可由 package.json 随时重新安装。
# 教学产物是 playground 下的 .ts 源码与各主题目录下的 *.md / assets/*.svg。
node_modules/

# ---- 教学实操环境：TS 编译产物（typescript-core 课程）----
# 说明：tsc 默认与源文件同目录产出 .js，属编译产物而非教学内容，
# 可由 npx tsc 一条命令重新生成。
# ⚠️ 陷阱：不能裸写 *.js —— playground/scenario.js 是课 1 讲义引用的手写 JS 源文件。
# 后续若再新增手写 .js 示例，同样要在此加一条 ! 例外，否则会被连带吞掉。
/frontend/typescript-core/playground/*.js
!/frontend/typescript-core/playground/scenario.js

# ---- 教学实操环境：TS 编译产物目录（typescript-core 课程）----
# 背景：课 10 起的多个 playground 与实战项目 schema-guard 用 "outDir": "dist"
#   集中输出 tsc 编译产物（.js + .d.ts）；课 12 工具链对比用 dist-tsc/ dist-esbuild/，
#   课 14 编译流水线用 dist-syntax/ dist-type/。均属编译产物而非教学内容，
#   可由 npx tsc / esbuild 一条命令重新生成，源文件在产物目录外的 src/ examples/ 等。
# ⚠️ 只锚定 typescript-core 主题；dist/ 与 dist-*/ 分开写，避免 dist* 误伤未来
#   可能出现的 distribution / distributed 等同名手写目录。
frontend/typescript-core/**/dist/
frontend/typescript-core/**/dist-*/
# tsbuildinfo 是 tsc --build / --incremental 的增量编译缓存（JSON），与 dist 同类，
# 位于 tsconfig 同级（lesson-10/refs、lesson-15/layering 等 packages 下），可 100% 复现。
# 用全局 *.tsbuildinfo 而非锚定本主题：任何 TS 项目（含未来其他课程）都会生成。
*.tsbuildinfo

# ---- 教学实操环境：Consul 运行时数据（consul 课程）----
# 风险点：lesson-05 的集群配置里 data_dir 直指仓库内的 playground/cluster/data/，
# 节点一启动就地生成 raft.db、serf 快照、node-id、services 元数据（可再生，约 1 MB）。
# 教学产物是同目录下的 *.json 配置（node1.json / dc2.json 等），继续跟踪，不受影响。
consul/playground/cluster/data/

# consul-template 渲染产物：*.tpl / *.hcl 是教学载荷，渲染出来的 .out 不是
consul/playground/*.out

# ---- 下载的工具存放目录（consul 课程）----
# lesson-06 让学员把 consul / consul-template 二进制下载到这里；
# 二进制本体已被上面的 *.exe 忽略，剩下的第三方 LICENSE.txt 也不是教学内容。
consul/playground/tools/

# ---- 前端课程：Node 依赖目录（frontend/ 下 JS / TS 课程）----
# 风险点：模块化、实战项目等章节一旦执行 npm install，node_modules/ 会就地生成
# （数万文件、体积大、可再生）。npm-debug.log* 已被上面的 *.log 覆盖。
# 教学产物是各主题下的 *.md / assets/*.svg / 实现/ 里的源码，继续跟踪，不受影响。
node_modules/
.workbuddy/

# ---- npm 锁文件（elasticsearch 课程 l12-client / l13-client）----
# 风险点：这两个目录是「客户端实操」的临时项目，npm install 会就地生成
# package-lock.json（数百 KB、随依赖版本频繁变动、可 100% 由 npm install 重建）。
# 教学产物是里面的 *.js 脚本（讲义第四幕直接引用），继续跟踪，不受影响。
# 若将来这些目录升级为「需要锁定依赖版本的可复现教学项目」，再移除本条。
**/l12-client/package-lock.json
**/l13-client/package-lock.json

# ---- 教学实操环境：动画课程运行产物（animation-engine 课程）----
# 风险点：playground/ 下的脚本跑一次会生成九百多张 PNG 帧序列 + 导出成品。
# 实测分布（2026-09-02）：
#   帧序列  912 张 —— 位于 playground/<lesson>/<序列目录>/*.png（35 个序列目录）
#   对比图   25 张 —— 位于 playground/<lesson>/*.png（讲义「怎么翻看」表格直接引用）
# 因此按**层级**区分：只忽略"再深一层"的帧序列，保留顶层单张对比图
# （*.gitignore 中 * 不跨 /，故 */*/*.png 恰好只匹配第 3 层）
#
# 继续跟踪的教学产物：
#   - playground 下的 *.py 源码
#   - playground/<lesson>/*.png 单张对比图（含 capstone/verification_report.png）
#   - capstone/ai_nodes.json 输入数据
#   - 各主题目录下的 *.md / assets/*.svg
animation-engine/*/playground/*/*/*.png

# ffmpeg 导出成品（课 10 与结课实战产出，重跑即可再生）
animation-engine/*/playground/**/*.mp4
animation-engine/*/playground/**/*.gif

# ---- 教学实操环境：VictoriaMetrics 运行时数据（victoriametrics 课程）----
# 风险点：课 5 起讲存储内部结构，讲义要求学员 ls / xxd 翻看 indexdb 的 index.bin /
# items.bin / metaindex.bin（zstd 魔数 28 b5 2f fd，实测 739 个 .bin 共约 35 MB）。
# 这些是 -storageDataPath 就地生成的存储文件，随每次写入/合并变化，
# 学员照讲义重启一次就能重建，不是教学内容。
# 教学产物是同目录外的 playground 顶层 *.sh / *.py / *.yml 脚本（讲义正文直接引用）
# 以及 stages/ 与各主题根目录下的 *.md / assets/*.svg，继续跟踪，不受影响。
# 用目录级 + 扩展名级双保险：目录级拦住 parts.json / metadata.json / flock.lock /
# .vm_app_running 等同批残留；扩展名级防将来换 -storageDataPath 又冒出新目录。
victoriametrics/playground/cluster-data/
victoriametrics/playground/data/
victoriametrics/playground/*-data/
*.bin

# ---- 教学实操环境：VictoriaMetrics vmbackup 快照与 vmrestore 工作目录 ----
# 背景：2026-09-03 卫生检查（Phase 5 收尾）发现，既有 `*-data/` 规则只覆盖到
# `vmagent-data` / `vmagent-q50-data` 这类单层后缀，而课 11 的流聚合对照实验按
# 「每组一个 -remoteWrite.tmpDataPath」生成了 vmagent-aggr-data / -2 / -3 / -4
# 四个带数字后缀的目录（`*-data/` 匹配不到 `-data2`），共 12 个文件漏网。
# 同理，课 12 的 vmbackup / vmrestore 实操产出 l12-backup/（6.7M，41 个文件，
# 含 data/indexdb/**/metadata.json 与 backup_complete.ignore）与 l12-restore/
# （restore-in-progress、flock.lock），均为跑一次即再生的快照与临时工作目录。
# 教学产物不受影响：讲义正文只引用 `-dst=l12-backup` 这类命令用法（vmbackup /
# vmrestore 关键词命中 10 / 9 个文件，指向的是命令讲解而非快照内容本身），
# 快照本体删掉后学员照讲义重跑一条 vmbackup 即可重建。
# 用 **/ 前缀匹配任意层级，且避开中文目录名带来的编码风险（同 ES 分节做法）。
victoriametrics/playground/*-data*/
victoriametrics/playground/l12-backup/
victoriametrics/playground/l12-restore/

# ---- 教学实操环境：ES 结课实战项目的 npm 锁文件（elasticsearch 课程）----
# 风险点：在 projects/商品搜索服务/实现/ 下执行 npm install 会就地生成
# package-lock.json（随依赖版本频繁变动、可 100% 由 npm install 重建）。
# 本项目只有一个依赖，且版本已用精确版本钉死在 package.json
# （"@elastic/elasticsearch": "9.5.1"），锁文件对可复现性没有额外贡献。
# 用 **/ 而不是写死中文目录名，避免 .gitignore 里出现中文路径带来的编码风险。
# 教学产物是 实现/ 下的全部源码与 data/keyword.txt，继续跟踪，不受影响。
elasticsearch/projects/**/package-lock.json

# ---- 教学产物例外：elasticsearch/playground 中被讲义直接引用的文件（2026-09-02 清理时确认）----
# 背景：playground/* 会忽略整个实操沙盒，但其中 48 个文件被讲义正文直接引用，形式是
#   curl.exe ... --data-binary @D:/projects/learning/elasticsearch/playground/xxx.json
#   // playground/l13-client/02-vector.js
# 这些文件丢了，读者照抄讲义会直接失败 —— 课 15 评审就踩过"讲义引用的 6 个
# l15-*.json 根本不存在"这个坑。
# 处置：这 48 个文件**保持已跟踪状态**（.gitignore 对已跟踪文件不生效，故无需写 ! 例外，
# 也避免为了开例外而取消 l13-client/ 目录的忽略、导致验证脚本重新冒出来）。
# 同目录下的其余 85 个一次性验证脚本已于 2026-09-02 用 git rm --cached 移出索引，
# 讲义正文已含完整命令，丢了课程依然完整。下面按"课程编号通配 + 逐条"精确忽略它们，
# 不用 elasticsearch/playground/* 一刀切 —— 否则会连带吞掉上面那 48 个教学产物
# （已跟踪文件短期不受影响，但将来一旦删了重建就会被忽略，属于埋雷）。
# 课 5-11：整门课的 playground 脚本都没被讲义引用，按编号通配忽略
elasticsearch/playground/l5-*.sh
elasticsearch/playground/l6-*.sh
elasticsearch/playground/l7-*.sh
elasticsearch/playground/l8-*.sh
elasticsearch/playground/l9_trap2_*
elasticsearch/playground/l10-*.ps1
# 课 11 / 课 13：与保留文件同前缀，只能逐条
elasticsearch/playground/l11-matchall.json
elasticsearch/playground/l11-newdoc.json
elasticsearch/playground/l11-replicas0.json
elasticsearch/playground/l13-log2.json
elasticsearch/playground/l13-log3.json
elasticsearch/playground/l13-search-errors.json
# 运行残留
elasticsearch/playground/node-3-r2.err
# l13-client：一次性验证 / 评审 / 清理脚本（与保留的 14-templates.js、15-alias.js、
# 16-ilm-lifecycle.js、17-ops.js、20-verify-l15-json.js、26-verify-l15-ilm.js 同名段交错，逐条列）
elasticsearch/playground/l13-client/review-*.js
elasticsearch/playground/l13-client/08-verify.js
