{
  "policy": {
    "phases": {
      "hot": {
        "min_age": "0ms",
        "actions": {
          "rollover": { "max_docs": 2 },
          "set_priority": { "priority": 100 }
        }
      },
      "warm": {
        "min_age": "0s",
        "actions": { "set_priority": { "priority": 50 } }
      },
      "delete": {
        "min_age": "1m",
        "actions": { "delete": {} }
      }
    }
  }
}
