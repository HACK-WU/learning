# =========================================================
# LangChain 课程 · TypeScript 侧 API 凭据模板
# 用法：复制本文件为 .env（或直接使用 ../playground/.env，脚本会自动回退读取）
#       .env 已被 git 忽略，不会入库
# 课程默认使用阿里云百炼（成本更低）；DeepSeek 作为备用链路
# Embedding 向量化（知识库相关课程）使用 SiliconFlow
# =========================================================

# ---- 阿里云百炼（OpenAI 兼容端点）----
# 端点在百炼控制台/服务方提供的接入信息中查找，形如 https://<host>/compatible-mode/v1
BAILIAN_API_KEY=<YOUR_BAILIAN_API_KEY>
BAILIAN_BASE_URL=<YOUR_BAILIAN_OPENAI_COMPATIBLE_ENDPOINT>

# ---- DeepSeek ----
DEEPSEEK_API_KEY=<YOUR_DEEPSEEK_API_KEY>
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- SiliconFlow（Embedding 专用：知识库向量化）----
SILICONFLOW_API_KEY=<YOUR_SILICONFLOW_API_KEY>
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B