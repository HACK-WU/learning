# =========================================================
# LangChain 课程 · API 凭据模板
# 用法：复制本文件为 .env，填入自己的 Key 与端点（.env 已被 git 忽略，不会入库）
# 课程默认使用阿里云百炼（成本更低）；DeepSeek 作为备用链路
# Embedding 向量化（知识库相关课程）使用 SiliconFlow
# =========================================================

# ---- 阿里云百炼（OpenAI 兼容端点）----
# 端点在百炼控制台/服务方提供的接入信息中查找，形如 https://<host>/compatible-mode/v1
BAILIAN_API_KEY=<YOUR_BAILIAN_API_KEY>
BAILIAN_BASE_URL=<YOUR_BAILIAN_OPENAI_COMPATIBLE_ENDPOINT>
# Anthropic 兼容端点（备用，形如 https://<host>/apps/anthropic）
BAILIAN_ANTHROPIC_BASE_URL=<YOUR_BAILIAN_ANTHROPIC_ENDPOINT>

# ---- DeepSeek ----
DEEPSEEK_API_KEY=<YOUR_DEEPSEEK_API_KEY>
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Anthropic 兼容端点（备用）
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# ---- SiliconFlow（Embedding 专用：知识库向量化）----
# OpenAI 兼容端点；Key 在 https://cloud.siliconflow.cn 控制台获取
SILICONFLOW_API_KEY=<YOUR_SILICONFLOW_API_KEY>
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# 默认 Qwen3-Embedding-8B（4096 维；支持 dimensions 参数做 MRL 截维）
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
SILICONFLOW_EMBEDDING_DIMS=4096
