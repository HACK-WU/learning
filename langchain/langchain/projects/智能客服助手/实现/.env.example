# =========================================================
# 智能客服助手 · API 凭据模板
# 用法：复制本文件为 .env，填入自己的 Key 与端点（.env 已被 git 忽略，不会入库）
# 对话模型：阿里云百炼（OpenAI 兼容端点）；嵌入模型：SiliconFlow（知识库向量化）
# =========================================================

# ---- 对话模型（阿里云百炼，OpenAI 兼容端点）----
# 端点在百炼控制台/服务方提供的接入信息中查找，形如 https://<host>/compatible-mode/v1
BAILIAN_API_KEY=<YOUR_BAILIAN_API_KEY>
BAILIAN_BASE_URL=<YOUR_BAILIAN_OPENAI_COMPATIBLE_ENDPOINT>
# 对话模型名（可选，默认 qwen3.8-flash）
CHAT_MODEL=qwen3.8-flash

# ---- 嵌入模型（SiliconFlow：知识库向量化）----
# Key 在 https://cloud.siliconflow.cn 控制台获取
SILICONFLOW_API_KEY=<YOUR_SILICONFLOW_API_KEY>
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# ---- 业务参数（可选，均有默认值）----
# 退款人工审批阈值（元）：退款金额 >= 该值时触发人工审批，否则直通
REFUND_APPROVAL_THRESHOLD=50
