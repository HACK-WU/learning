# =========================================================
# Deep Agents 课程 · TypeScript 侧 API 凭据模板
# 用法：复制本文件为 .env（或复用 ../playground/.env，脚本会自动回退读取）
#       .env 已被 git 忽略，不会入库
# =========================================================

# ---- 阿里云百炼（OpenAI 兼容端点）----
BAILIAN_API_KEY=<YOUR_BAILIAN_API_KEY>
BAILIAN_BASE_URL=<YOUR_BAILIAN_OPENAI_COMPATIBLE_ENDPOINT>

# ---- DeepSeek ----
DEEPSEEK_API_KEY=<YOUR_DEEPSEEK_API_KEY>
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- 默认模型（两侧共用；改这里可整体切换）----
# Deep Agents 官方默认是 anthropic:claude-sonnet-4-6
# 本课程对齐 LangChain 教程口径，默认走百炼 OpenAI 兼容端点
DEEPAGENTS_MODEL=openai:qwen3.8-flash
