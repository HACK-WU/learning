{
  "uid": "prov-dash-001",
  "title": "Provisioned Node Overview",
  "tags": ["provisioning", "lesson10"],
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "30s",
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU idle by instance",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "provprom" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "provprom" },
          "editorMode": "code",
          "expr": "rate(node_cpu_seconds_total{mode=\"idle\"}[5m])",
          "legendFormat": "{{instance}}",
          "intervalMs": 1000,
          "maxDataPoints": 43200
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "provprom" },
        "query": "label_values(node_cpu_seconds_total, instance)",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": []
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "annotations": { "list": [] },
  "links": []
}
