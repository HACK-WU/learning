{
  "uid": "shop-overview",
  "title": "Shop 可观测性总览（告警 → 指标 → 日志 → 链路）",
  "tags": [
    "shop",
    "capstone"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "接口",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "shop-prom"
        },
        "query": "label_values(shop_requests_total, route)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "level",
        "label": "日志级别",
        "type": "custom",
        "query": "INFO,DEBUG,WARN,ERROR",
        "current": {
          "text": "ERROR",
          "value": "ERROR"
        },
        "options": [],
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "① 请求速率 QPS（按接口）",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "shop-prom"
          },
          "expr": "sum(rate(shop_requests_total{route=~\"$route\"}[$__rate_interval])) by (route)",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Rate：每秒请求数。告警第一眼看这里，判断影响面。"
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "② 错误率（按接口）",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "shop-prom"
          },
          "expr": "sum(rate(shop_requests_total{route=~\"$route\",status=\"500\"}[$__rate_interval])) by (route)",
          "legendFormat": "{{route}} 5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Errors：每秒错误数。这里涨了说明真出问题了，不是流量大。"
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "③ P90 延迟（按接口）",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "shop-prom"
          },
          "expr": "histogram_quantile(0.9, sum by (le, route) (rate(shop_request_duration_seconds_bucket{route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "{{route}} P90"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "shop-prom"
          },
          "expr": "histogram_quantile(0.5, sum by (le, route) (rate(shop_request_duration_seconds_bucket{route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "{{route}} P50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line"
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Duration：P90/P50 延迟。只盯平均值会被长尾骗，必须看分位数。"
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "④ 慢请求的 trace（exemplar，点圆点跳链路）",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "shop-prom"
          },
          "expr": "histogram_quantile(0.9, sum by (le) (rate(shop_request_duration_seconds_bucket{route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "P90",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line"
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "【指标 → 链路】hover 图上的小圆点即可跳到对应 trace。前提是数据源配了 exemplarTraceIdDestinations。"
    },
    {
      "id": 5,
      "type": "logs",
      "title": "⑤ 原始日志（含 trace_id，点进去跳链路）",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "shop-loki"
          },
          "expr": "{job=\"shop\", service=\"shop-api\"} | json | level=\"$level\" | route=~\"$route\""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showLabels": false,
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "description": "【日志 → 链路】日志行里的 trace_id 是可点击链接，由数据源的 derivedFields 配置生成。"
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "⑥ 错误分布（哪个接口、哪种错误）",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "shop-prom"
          },
          "expr": "sum by (route, error_type) (increase(shop_errors_total{route=~\"$route\"}[$__range]))",
          "legendFormat": "{{route}} / {{error_type}}",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "orientation": "horizontal"
      },
      "description": "定位：错误集中在哪个接口、哪类错误，决定先修哪个。"
    },
    {
      "id": 7,
      "type": "stat",
      "title": "⑦ 当前并发请求数",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 8,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "shop-prom"
          },
          "expr": "sum(shop_inflight_requests)",
          "legendFormat": "并发"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "stat",
      "title": "⑧ 健康状态总览",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 12,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "shop-prom"
          },
          "expr": "min(up{job=\"shop\"})",
          "legendFormat": "应用存活"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "宕机",
                  "color": "red"
                },
                "1": {
                  "text": "正常",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "⑨ 主机 CPU（排除干扰：是应用问题还是机器问题）",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "shop-prom"
          },
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval]))",
          "legendFormat": "CPU 使用率"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line"
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "排除法：如果应用慢但 CPU 正常，问题多半在下游或外部依赖。"
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Grafana 告警",
        "enable": true,
        "iconColor": "red",
        "datasource": {
          "type": "grafana",
          "uid": "grafana"
        },
        "type": "dashboard"
      }
    ]
  },
  "description": "实战项目主盘。排查动线：①看 QPS 判断影响面 → ②看错误率确认是故障不是流量 → ③看 P90 定位慢接口 → ④点 exemplar 跳链路 → ⑤看日志找 trace_id → ⑥定位错误类型。"
}